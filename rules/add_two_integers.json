{
  "problem": "add_two_integers",
  "statement_file": "problems/add_two_integers/statement.md",
  "reference_solution": "problems/add_two_integers/reference.c",
  "time_limit_s": 1,
  "memory_limit_mb": 64,
  "compile_flags": "-O2 -Wall -Wextra -std=c11",
  "compare": "tokens",
  "sample_input": "7 5\n",
  "sample_output": "12\n",
  "input_format": {
    "lines": [[{"name": "a", "type": "int"}, {"name": "b", "type": "int"}]]
  },
  "metrics": [
    {
      "name": "correctness",
      "analyzer": "io_tests",
      "weight": 0.20,
      "params": {"testset_dir": "tests/add/"}
    },
    {
      "name": "syntax",
      "analyzer": "compiler_warnings",
      "weight": 0.10,
      "params": {"flags": "-Wall -Wextra -Werror -std=c11", "penalty_per_warning": 0.1}
    },
    {
      "name": "structure",
      "analyzer": "static_analysis",
      "weight": 0.10,
      "params": {"max_cyclomatic": 8, "max_function_length": 40}
    },
    {
      "name": "modularity",
      "analyzer": "function_split",
      "weight": 0.10,
      "params": {"expect_helpers": true, "min_functions": 2}
    },
    {
      "name": "logical",
      "analyzer": "edge_case_runner",
      "weight": 0.10,
      "params": {"cases": ["negatives", "zero", "int_overflow", "whitespace", "llm"], "llm_cases": 5}
    },
    {
      "name": "complexity",
      "analyzer": "complexity_estimator",
      "weight": 0.10,
      "params": {"required": "O(1)", "sizes": [1, 10, 100]}
    },
    {
      "name": "memory_safety",
      "analyzer": "sanitizer_run",
      "weight": 0.10,
      "params": {"flags": "-fsanitize=address,undefined", "leak_check": true}
    },
    {
      "name": "readability",
      "analyzer": "llm_review",
      "weight": 0.10,
      "params": {"model": "openai/gpt-oss-120b", "temperature": 0, "seed": 42}
    },
    {
      "name": "originality",
      "analyzer": "similarity_flag",
      "weight": 0.10,
      "params": {"corpus_dir": "submissions/add_two_integers/", "flag_threshold": 0.85, "llm_reference_solutions": 3}
    }
  ]
}
